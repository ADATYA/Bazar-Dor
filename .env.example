# Copy this file to .env.local and fill it in
# Generate a secret:  openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Local: http://localhost:3000  | Vercel: https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000
# MongoDB Atlas connection string (include a database name at the end)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/bazardor
# Optional social login (leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_API_URL=https://openapi.programming-hero.com/api/bazardor
